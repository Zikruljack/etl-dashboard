# ============================================================
# ETL Dashboard — Production Environment
# Copy this file to .env, fill in the values, then run:
#   docker compose --env-file .env up -d
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
# Password for the postgres user inside the Docker container
POSTGRES_PASSWORD=change-me-strong-password

# ── JWT ──────────────────────────────────────────────────────
# Must be at least 32 random characters — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-super-secret-jwt-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# ── Public API URL ───────────────────────────────────────────
# URL the BROWSER uses to reach the API server.
# If running behind a reverse proxy with a domain, use the domain.
# If exposing directly, use the server's public IP.
#
# Examples:
#   NUXT_PUBLIC_API_BASE=https://api.yourdomain.com/api
#   NUXT_PUBLIC_API_BASE=http://203.0.113.10:8989/api
NUXT_PUBLIC_API_BASE=http://your-server-ip-or-domain:8989/api

# ── Google Sheets (optional) ─────────────────────────────────
# Leave empty if not using Google Sheets connector.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
